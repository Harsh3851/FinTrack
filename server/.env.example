# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (Render: 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0

# MongoDB. Leave empty and run `npm run dev:memory -w server` to use an in-memory database instead.
MONGODB_URI=mongodb://127.0.0.1:27017/fintrack

# JWT secrets: 32+ random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173

# Refresh-token cookie. For a client on a different site (GitHub Pages -> Render) use
# COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Enables POST /api/v1/auth/demo (one-click login as the seeded demo user).
DEMO_ENABLED=true
